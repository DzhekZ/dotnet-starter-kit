<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>9fe5df9a-b9b2-4202-bdb4-d30b01b71d1a</UserSecretsId>
    <IsPackable>false</IsPackable>
    <!-- ASPIRE010 (13.5+): we run via `dotnet run` with NuGet-restored DCP/dashboard, not the Aspire CLI bundle. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <!-- Aspire 17: the AppHost is a plain Microsoft.NET.Sdk project (Aspire.AppHost.Sdk is obsolete, ASPIRE012).
       .NET services are added by path via AddDotnetProject(name, path) in AppHost.cs, so the API and DbMigrator
       are no longer ProjectReferences here. -->
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.Dotnet" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.Redis" />
  </ItemGroup>

</Project>
